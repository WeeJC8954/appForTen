rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can only read/write their own notes.
    match /notes/{noteId} {
      allow read, delete: if request.auth != null && resource.data.owner == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000;
    }

    // One Pokédex team per user, document id = their uid.
    match /teams/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['members', 'updated'])
        && request.resource.data.members is list
        && request.resource.data.members.size() <= 6;
    }
  }
}
